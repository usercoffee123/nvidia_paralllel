{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run worker",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/worker.py",
            "args": [
                "--rows",
                "3000",
                "--cols",
                "6"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/ve/bin/python",
            "console": "integratedTerminal"
        },
        {
            "name": "Run worker (large)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/worker.py",
            "args": [
                "--rows",
                "20000",
                "--cols",
                "9"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/ve/bin/python",
            "console": "integratedTerminal"
        }
    ]
}